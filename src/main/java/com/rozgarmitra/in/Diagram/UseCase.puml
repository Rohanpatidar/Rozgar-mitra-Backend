@startuml
left to right direction
skinparam packageStyle rectangle

actor Admin
actor Customer
actor Labour

rectangle "Rozgar Mitra System" {
  usecase "Add New Service" as UC1
  usecase "View System Stats" as UC2

  usecase "Request Labour (Radius Based)" as UC3
  usecase "Generate Start/End OTP" as UC4
  usecase "Pay Hourly Charges" as UC5

  usecase "View Incoming Requests" as UC6
  usecase "Accept/Reject Request" as UC7
  usecase "Enter OTP for Verification" as UC8
}

Admin --> UC1
Admin --> UC2

Customer --> UC3
Customer --> UC4
Customer --> UC5

Labour --> UC6
Labour --> UC7
Labour --> UC8

UC3 .> UC6 : triggers notification
@enduml